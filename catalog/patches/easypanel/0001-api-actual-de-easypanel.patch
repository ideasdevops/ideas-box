     # Valid EasyPanel service types with their own tRPC namespace.
     _VALID_SERVICE_TYPES = ["app", "postgres", "redis", "mysql", "mongodb", "mariadb"]
 
+    async def _list_projects_and_services(self) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
+        """
+        Fetch projects and services in one round-trip.
+
+        EasyPanel identifies resources by name, so every project gets "id" = its name
+        and every service gets "id" = "<projectName>/<serviceName>".
+        """
+        result = await self._trpc_request("projects.listProjectsAndServices")
+        projects = result.get("projects", []) if isinstance(result, dict) else []
+        services = result.get("services", []) if isinstance(result, dict) else []
+        for proj in projects:
+            proj.setdefault("id", proj.get("name"))
+        for service in services:
+            service["id"] = f"{service.get('projectName')}/{service.get('name')}"
+        return projects, services
+
+    async def _service_ref(self, service_id: str) -> dict[str, str]:
+        """
+        Turn a service id into the {projectName, serviceName} pair EasyPanel expects.
+
+        Accepts "<project>/<service>" or a bare service name when it is unique.
+        """
+        if "/" in service_id:
+            project_name, service_name = service_id.split("/", 1)
+            return {"projectName": project_name, "serviceName": service_name}
+        _, services = await self._list_projects_and_services()
+        matches = [s for s in services if s.get("name") == service_id]
+        if len(matches) != 1:
+            raise RuntimeError(
+                f"Service '{service_id}' is ambiguous or unknown; use '<project>/<service>'"
+            )
+        return {"projectName": matches[0]["projectName"], "serviceName": service_id}
+
     async def _resolve_service_namespace(self, service_id: str) -> str:
         """
