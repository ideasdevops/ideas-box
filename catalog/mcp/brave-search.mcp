ID="brave-search"
TITLE="Brave Search — búsqueda web para los agentes"
DESC="Búsqueda web, noticias, imágenes y resúmenes. Es la fuente de investigación de marketing y ventas."
TIER="core"
KIND="node"
REPO="https://github.com/brave/brave-search-mcp-server.git"
REF="main"
DIR="brave-search-mcp-server"
BUILD="npm install --no-audit --no-fund && npm run build"
CMD="__NODE__"
ARGS_JSON='["__SRC__/dist/index.js"]'
ENV_KEYS="BRAVE_API_KEY"
ENV_SECRET="BRAVE_API_KEY"
ENV_PROMPT_BRAVE_API_KEY="API key de Brave Search (gratis hasta 2.000 consultas/mes en brave.com/search/api)"
TOOLGROUP="brave"
NOTES="Sin API key el servidor arranca pero toda búsqueda falla."
