ID="inkscape"
TITLE="Inkscape — diseño vectorial"
DESC="Generar y editar SVG, exportar piezas gráficas. Necesita Inkscape instalado en el equipo."
TIER="opcional"
KIND="python"
REPO="https://github.com/sandraschi/inkscape-mcp.git"
REF="main"
DIR="inkscape-mcp"
CMD="__SRC__/venv/bin/python"
ARGS_JSON='["-m", "inkscape_mcp.main", "--mode", "stdio"]'
REQUIRES_HOST="inkscape"
ENV_KEYS="INKSCAPE_PATH"
ENV_PROMPT_INKSCAPE_PATH="Ruta al ejecutable de Inkscape (/usr/bin/inkscape)"
TOOLGROUP="inkscape"
