ID="obsidian"
TITLE="Obsidian — bóveda de notas"
DESC="Leer y escribir en una bóveda de Obsidian desde los agentes. Alternativa a la memoria en archivos del stack."
TIER="opcional"
KIND="node"
REPO="https://github.com/cyanheads/obsidian-mcp-server.git"
REF="main"
DIR="obsidian-mcp-server"
BUILD="npm install --no-audit --no-fund && npm run build"
CMD="__NODE__"
ARGS_JSON='["__SRC__/dist/index.js"]'
ENV_KEYS="OBSIDIAN_API_KEY OBSIDIAN_BASE_URL"
ENV_SECRET="OBSIDIAN_API_KEY"
ENV_PROMPT_OBSIDIAN_API_KEY="API key del plugin Local REST API"
ENV_PROMPT_OBSIDIAN_BASE_URL="URL local del plugin (https://127.0.0.1:27124)"
TOOLGROUP="obsidian"
