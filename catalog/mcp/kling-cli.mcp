ID="kling-cli"
TITLE="Kling CLI — el mismo Kling desde la terminal, con su skill oficial"
DESC="Alternativa al conector: comando 'kling' más el skill oficial de Kling, que los agentes usan por Bash. Kling lo recomienda por estabilidad en tareas largas o en lote."
TIER="opcional"
KIND="tool"
INSTALL_CUSTOM="NODE_BIN=__NODE__ bash \"$STACK_SRC/catalog/installers/kling-cli.sh\""
SKILL_PACK="kling"
CHECK_CMD="$HOME/.local/bin/kling"
AUTH_CHECK="\"$HOME/.local/bin/kling\" who_am_i"
LOGIN_CMD="\"$HOME/.local/bin/kling\" login"
NOTES="Es la versión internacional (kling.ai). Las cuentas de China continental (klingai.com) usan otro paquete: @klingai/cli-cn."
