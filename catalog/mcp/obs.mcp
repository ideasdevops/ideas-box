ID="obs"
TITLE="OBS Studio — control de grabación y streaming"
DESC="Controlar escenas, grabación y streaming de OBS. Necesita OBS con websocket habilitado."
TIER="opcional"
KIND="node"
REPO="https://github.com/royshil/obs-mcp.git"
REF="main"
DIR="obs-mcp"
BUILD="npm install --no-audit --no-fund && npm run build"
CMD="__NODE__"
ARGS_JSON='["__SRC__/build/index.js"]'
ENV_KEYS="OBS_WEBSOCKET_PASSWORD"
ENV_SECRET="OBS_WEBSOCKET_PASSWORD"
ENV_PROMPT_OBS_WEBSOCKET_PASSWORD="Contraseña del websocket de OBS (Herramientas → Configuración de WebSocket)"
TOOLGROUP="obs"
