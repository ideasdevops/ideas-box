ID="youtube"
TITLE="YouTube — investigación de canales y transcripciones"
DESC="Buscar videos, leer datos de canales y bajar transcripciones para investigación de contenido."
TIER="negocio"
KIND="node"
REPO="https://github.com/ZubeidHendricks/youtube-mcp-server.git"
REF="main"
DIR="youtube-mcp-server"
BUILD="npm install --no-audit --no-fund && npm run build"
CMD="__NODE__"
ARGS_JSON='["__SRC__/dist/index.js"]'
ENV_KEYS="YOUTUBE_API_KEY"
ENV_SECRET="YOUTUBE_API_KEY"
ENV_PROMPT_YOUTUBE_API_KEY="API key de YouTube Data API v3 (Google Cloud Console)"
TOOLGROUP="youtube"
