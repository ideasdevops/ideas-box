ID="google-ads"
TITLE="Google Ads (escritura) — gestión de campañas autoalojada"
DESC="MCP en Go con escritura real sobre Google Ads y confirmación previa por operación."
TIER="opcional"
KIND="custom"
REPO="https://github.com/Limetric/ads.git"
REF="main"
DIR="goads"
INSTALL_CUSTOM="bash \"$STACK_SRC/catalog/installers/google-ads.sh\""
CMD="$HOME/.local/share/mcp-servers/goads/bin/goads"
ARGS_JSON='[]'
REQUIRES_HOST="go"
ENV_KEYS="GOOGLE_ADS_DEVELOPER_TOKEN GOOGLE_ADS_CLIENT_ID GOOGLE_ADS_CLIENT_SECRET GOOGLE_ADS_REFRESH_TOKEN GOOGLE_ADS_LOGIN_CUSTOMER_ID"
ENV_SECRET="GOOGLE_ADS_DEVELOPER_TOKEN GOOGLE_ADS_CLIENT_SECRET GOOGLE_ADS_REFRESH_TOKEN"
ENV_PROMPT_GOOGLE_ADS_DEVELOPER_TOKEN="Developer token de Google Ads API"
ENV_PROMPT_GOOGLE_ADS_CLIENT_ID="OAuth client ID"
ENV_PROMPT_GOOGLE_ADS_CLIENT_SECRET="OAuth client secret"
ENV_PROMPT_GOOGLE_ADS_REFRESH_TOKEN="Refresh token OAuth"
ENV_PROMPT_GOOGLE_ADS_LOGIN_CUSTOMER_ID="ID de la cuenta MCC (solo dígitos)"
TOOLGROUP="google-ads"
NOTES="Escribe en campañas reales con gasto: dejalo detrás de aprobación explícita."
