ID="ssh-infra"
TITLE="SSH/Docker — acceso controlado a tus servidores"
DESC="Info de sistema, docker ps, logs y stats por SSH. Los comandos arbitrarios y los backups piden aprobación."
TIER="negocio"
KIND="python"
VENDOR="infra-ssh-mcp"
DIR="infra-ssh-mcp"
CMD="__SRC__/venv/bin/infra-ssh-mcp"
ARGS_JSON='[]'
MULTI=1
INSTANCE_PROMPT="Etiqueta de este servidor (ej: produccion)"
ENV_KEYS="SSH_HOST SSH_USER SSH_KEY_PATH CLIENT_LABEL"
ENV_SECRET=""
ENV_PROMPT_SSH_HOST="IP o hostname del servidor"
ENV_PROMPT_SSH_USER="Usuario SSH"
ENV_PROMPT_SSH_KEY_PATH="Ruta a la clave privada (ej: ~/.ssh/id_ed25519)"
ENV_PROMPT_CLIENT_LABEL="Nombre legible del servidor (aparece en los reportes)"
TOOLGROUP="ssh"
NOTES="Usa clave SSH, nunca contraseña. Los backups se bajan a 05-OPERACIONES/backups de tu raíz de datos."
