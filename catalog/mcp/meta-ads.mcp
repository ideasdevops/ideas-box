ID="meta-ads"
TITLE="Meta Ads (escritura) — gestión de campañas autoalojada"
DESC="Crear, pausar y editar campañas de Meta Ads desde los agentes."
TIER="opcional"
KIND="python"
REPO="https://github.com/Mike25app/scaleforge-mcp-meta-ads.git"
REF="main"
DIR="scaleforge-meta-ads"
CMD="__SRC__/venv/bin/python"
ARGS_JSON='["-m", "meta_ads_mcp"]'
ENV_KEYS="META_ACCESS_TOKEN META_AD_ACCOUNT_ID"
ENV_SECRET="META_ACCESS_TOKEN"
ENV_PROMPT_META_ACCESS_TOKEN="Access token con ads_management"
ENV_PROMPT_META_AD_ACCOUNT_ID="ID de cuenta publicitaria (act_XXXXXXXX)"
TOOLGROUP="meta-ads"
NOTES="Escribe en campañas con gasto real: aprobación explícita obligatoria."
