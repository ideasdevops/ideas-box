ID="chatwoot"
TITLE="Chatwoot — bandeja omnicanal (WhatsApp, web, email)"
DESC="Leer conversaciones y responder clientes desde los agentes. Requiere una instancia de Chatwoot ya funcionando."
TIER="negocio"
KIND="node"
REPO="https://github.com/hugoblanc/chatwoot-mcp.git"
REF="main"
DIR="chatwoot-mcp"
BUILD="npm install --no-audit --no-fund && npm run build"
CMD="__NODE__"
ARGS_JSON='["__SRC__/dist/index.js"]'
MULTI=1
INSTANCE_PROMPT="Etiqueta de esta cuenta de Chatwoot"
ENV_KEYS="CHATWOOT_BASE_URL CHATWOOT_API_TOKEN CHATWOOT_ACCOUNT_ID"
ENV_SECRET="CHATWOOT_API_TOKEN"
ENV_PROMPT_CHATWOOT_BASE_URL="URL de tu Chatwoot (https://chat.tuempresa.com)"
ENV_PROMPT_CHATWOOT_API_TOKEN="Access token del perfil de agente"
ENV_PROMPT_CHATWOOT_ACCOUNT_ID="ID de cuenta (normalmente 1)"
TOOLGROUP="chatwoot"
NOTES="Enviar mensajes a un cliente real siempre pide aprobación explícita; está escrito en el agente comms-chatwoot."
