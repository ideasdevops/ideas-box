ID="facebook"
TITLE="Facebook Page — publicación, comentarios y métricas"
DESC="Publicar en una página, responder comentarios y leer insights."
TIER="negocio"
KIND="python"
REPO="https://github.com/Livia-Zaharia/just_facebook_mcp.git"
REF="main"
DIR="just_facebook_mcp"
CMD="__SRC__/venv/bin/just_facebook_mcp"
ARGS_JSON='[]'
MULTI=1
INSTANCE_PROMPT="Etiqueta de esta página de Facebook"
ENV_KEYS="FACEBOOK_ACCESS_TOKEN FACEBOOK_PAGE_ID"
ENV_SECRET="FACEBOOK_ACCESS_TOKEN"
ENV_PROMPT_FACEBOOK_ACCESS_TOKEN="Page Access Token (de la página, no de System User)"
ENV_PROMPT_FACEBOOK_PAGE_ID="ID de la página"
TOOLGROUP="facebook"
NOTES="Tiene que ser un Page Access Token: con un token de System User las publicaciones fallan."
