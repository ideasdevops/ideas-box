ID="instagram"
TITLE="Instagram Business — publicación y métricas"
DESC="Publicar, leer insights y mensajes de una cuenta de Instagram Business vinculada a una página de Facebook."
TIER="negocio"
KIND="python"
REPO="https://github.com/jlbadano/ig-mcp.git"
REF="main"
DIR="ig-mcp"
BUILD="venv/bin/pip install --quiet -r requirements.txt"
CMD="__SRC__/venv/bin/python"
ARGS_JSON='["-m", "src.instagram_mcp_server"]'
MULTI=1
INSTANCE_PROMPT="Etiqueta de esta cuenta de Instagram"
ENV_KEYS="INSTAGRAM_ACCESS_TOKEN INSTAGRAM_BUSINESS_ACCOUNT_ID FACEBOOK_APP_ID FACEBOOK_APP_SECRET"
ENV_SECRET="INSTAGRAM_ACCESS_TOKEN FACEBOOK_APP_SECRET"
ENV_PROMPT_INSTAGRAM_ACCESS_TOKEN="Access token de larga duración"
ENV_PROMPT_INSTAGRAM_BUSINESS_ACCOUNT_ID="ID de la cuenta business de Instagram"
ENV_PROMPT_FACEBOOK_APP_ID="App ID de Meta for Developers"
ENV_PROMPT_FACEBOOK_APP_SECRET="App Secret"
TOOLGROUP="instagram"
NOTES="Necesita PYTHONPATH al repo; el lanzador lo resuelve solo."
LAUNCH_ENV="PYTHONPATH=__SRC__"
